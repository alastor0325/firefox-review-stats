<script>
const DATA = __DATA_JSON__;
const PHAB_DATA = __PHAB_DATA_JSON__;
const RECENT = DATA.recent_changes || null;
// Only the team that has a roadmap gets a payload here; null everywhere else,
// which is what removes the Media Health tab. Both subviews are driven by this
// one payload: Roadmap renders `items`, Performance renders `metrics`.
const ROADMAP = __ROADMAP_DATA_JSON__;
const METRICS = __METRICS_DATA_JSON__;

const tipEl = document.createElement('div');
tipEl.className = 'tip-floating';
document.body.appendChild(tipEl);

function attachTooltips(root) {
  root.querySelectorAll('.info').forEach(icon => {
    if (icon.dataset.tipBound) return;
    icon.dataset.tipBound = '1';
    icon.addEventListener('mouseenter', () => {
      tipEl.textContent = icon.dataset.tip;
      tipEl.style.display = 'block';
      tipEl.style.left = '0px';
      tipEl.style.top = '0px';
      const tipR = tipEl.getBoundingClientRect();
      const iconR = icon.getBoundingClientRect();
      const margin = 8;
      let top = iconR.bottom + 6;
      if (top + tipR.height > window.innerHeight - margin) {
        top = Math.max(margin, iconR.top - tipR.height - 6);
      }
      let left = iconR.left;
      if (left + tipR.width > window.innerWidth - margin) {
        left = window.innerWidth - tipR.width - margin;
      }
      if (left < margin) left = margin;
      tipEl.style.left = left + 'px';
      tipEl.style.top = top + 'px';
    });
    icon.addEventListener('mouseleave', () => { tipEl.style.display = 'none'; });
  });
}

const fmtPct = v => (v * 100).toFixed(1) + '%';
const fmtNum = v => (typeof v === 'number' && !Number.isInteger(v)) ? v.toFixed(1) : v;

// Editorial palette: Mozilla red lead, with restrained earth + ink tones.
// Chosen for cohesion with the paper-and-ink page aesthetic and for clear
// adjacent-hue contrast in stacked / categorical charts.
const PALETTE = [
  '#FF0039', '#1B3B6F', '#3F5E3F', '#C89B3C', '#7A3B5C',
  '#5B6B7C', '#A4513B', '#8FA47A', '#2D4A87', '#9F7E5E',
  '#5D7B5D', '#B85850', '#446B7F', '#876B49', '#6F4D6F',
];
const color = i => PALETTE[i % PALETTE.length];

// Single-chart accents (referenced below). Kept as named tokens so any
// future tuning of the editorial palette only needs to change one place.
const COLOR_RED    = '#FF0039';  // bus-factor / sole reviewer — high-attention
const COLOR_NAVY   = '#1B3B6F';  // primary data / in-group / wait time
const COLOR_FOREST = '#3F5E3F';  // top-authors bar (standalone)
const COLOR_GRAY   = '#C9C0AE';  // out-of-group / muted backing series
// Warm complement to NAVY used as the second series in the Member /
// Weekly chart. Forest was visually too close to navy when both lines
// overlap; mustard splits warm/cool so reviews-vs-submitted reads
// cleanly even on a small viewport or for users with red-green
// colour vision deficiency.
const COLOR_MUSTARD = '#C89B3C';

function escAttr(s) { return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }
function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// Convert an ISO week label like "2026-W20" into the calendar range
// "May 11 – May 17, 2026" so weekly-chart tooltips show real dates.
function isoWeekToDateRange(label) {
  const m = String(label).match(/^(\d{4})-W(\d{2})$/);
  if (!m) return null;
  const year = +m[1], week = +m[2];
  // ISO 8601: week 1 is the week containing January 4th.
  const jan4 = new Date(Date.UTC(year, 0, 4));
  const dayOfWeek = (jan4.getUTCDay() + 6) % 7;  // 0 = Monday
  const week1Monday = new Date(jan4);
  week1Monday.setUTCDate(jan4.getUTCDate() - dayOfWeek);
  const monday = new Date(week1Monday);
  monday.setUTCDate(week1Monday.getUTCDate() + (week - 1) * 7);
  const sunday = new Date(monday);
  sunday.setUTCDate(monday.getUTCDate() + 6);
  const fmt = d => d.toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
  });
  return `${fmt(monday)} – ${fmt(sunday)}, ${sunday.getUTCFullYear()}`;
}

// Tooltip title callback that prepends the calendar range to the ISO
// week label so users can read both "what week is this" and "what
// dates is this" at a glance.
const weeklyTooltip = {
  callbacks: {
    title: (items) => {
      if (!items.length) return '';
      const label = items[0].label;
      const range = isoWeekToDateRange(label);
      return range ? `${label}  ·  ${range}` : label;
    },
  },
};

function stat(label, value, sub, info) {
  const d = document.createElement('div');
  d.className = 'stat';
  const tip = info ? `<span class="info" data-tip="${escAttr(info)}"></span>` : '';
  d.innerHTML = `<div class="label">${label}${tip}</div><div class="value">${value}</div>` + (sub ? `<div class="sub">${sub}</div>` : '');
  return d;
}

function giniOf(values) {
  if (values.length <= 1) return 0;
  const total = values.reduce((a, b) => a + b, 0);
  if (total === 0) return 0;
  const sorted = [...values].sort((a, b) => a - b);
  let weighted = 0;
  sorted.forEach((v, i) => { weighted += (i + 1) * v; });
  return (2 * weighted) / (sorted.length * total) - (sorted.length + 1) / sorted.length;
}

function busFactorOf(values, threshold) {
  if (!values.length) return 0;
  const total = values.reduce((a, b) => a + b, 0);
  if (total === 0) return 0;
  const sorted = [...values].sort((a, b) => b - a);
  let accum = 0;
  for (let i = 0; i < sorted.length; i++) {
    accum += sorted[i];
    if (accum / total >= threshold) return i + 1;
  }
  return sorted.length;
}

function weekStats(weekIndex) {
  const week = DATA.weekly_trend.weeks[weekIndex];
  const counts = {};
  for (const [m, arr] of Object.entries(DATA.weekly_trend.all_members)) {
    counts[m] = arr[weekIndex] || 0;
  }
  const values = Object.values(counts);
  const total = values.reduce((a, b) => a + b, 0);
  const active = values.filter(c => c > 0).length;
  const top = Object.entries(counts).sort((a, b) => b[1] - a[1])[0];
  const topShare = total > 0 ? top[1] / total : 0;
  return {
    week, total, active, top, topShare,
    gini: giniOf(values),
    busFactor: busFactorOf(values, 0.5),
  };
}

// Header
document.getElementById('header-group').textContent = DATA.meta.group;
const excludes = (DATA.meta.excludes || []);
// meta.paths is the multi-root list (one or more roots the team
// owns). meta.path is the legacy singular field, kept for older
// data files; falls back to that when meta.paths is missing.
const watched = (DATA.meta.paths || [DATA.meta.path]).join(', ');
// Title shows the group; the paths live in the meta subtitle so
// the H1 stays readable when a team owns several roots.
document.title = `Team Dashboard — ${DATA.meta.group}`;
const scope = excludes.length
  ? `${watched} (excluding ${excludes.join(', ')})`
  : watched;
const headerMeta = document.getElementById('header-meta');
headerMeta.innerHTML = '';
const scopeLine = document.createElement('div');
scopeLine.textContent = scope;
const timeLine = document.createElement('div');
timeLine.textContent =
  `${DATA.meta.window_start} → ${DATA.meta.window_end} · generated ${DATA.meta.generated_at_display || DATA.meta.generated_at}`;
headerMeta.appendChild(scopeLine);
headerMeta.appendChild(timeLine);

// =============================================================
// Team / Aggregate (1m / 3m / 6m) — single set of DOM nodes, re-rendered
// from the data slice that matches the current period toggle.
//
// Backed by `DATA.team_views[key]` and `PHAB_DATA.team_windows[key]`
// where key ∈ {"1m","3m","6m"}. Both blocks fall back to the top-level
// DATA / PHAB_DATA shape when the report was generated before the
// per-window slices were introduced — that fallback always reads as
// 6m, and the 1m / 3m buttons are hidden in that case.
// =============================================================

const PERIOD_TO_KEY = { 'total': '6m', '1m': '1m', '3m': '3m' };

// Track Chart instances so re-renders can destroy them before
// creating a replacement on the same <canvas> — Chart.js otherwise
// errors out with "Canvas is already in use by chart #N".
const teamCharts = {};
function resetChart(id) {
  if (teamCharts[id]) {
    teamCharts[id].destroy();
    delete teamCharts[id];
  }
}

function teamViewFor(periodKey) {
  if (DATA.team_views && DATA.team_views[periodKey]) {
    return DATA.team_views[periodKey];
  }
  // Older data files predate `team_views`; assemble the same shape
  // from the top-level fields so this path still renders something
  // (always reads as 6m — the 1m / 3m buttons are hidden in this case).
  return {
    summary: DATA.summary,
    concentration: DATA.concentration,
    within_group_total: DATA.within_group_total,
    sole_reviewer: DATA.sole_reviewer,
    total_reviews_per_member: DATA.total_reviews_per_member,
    authors: DATA.authors,
  };
}
function phabWindowFor(periodKey) {
  if (PHAB_DATA && PHAB_DATA.team_windows && PHAB_DATA.team_windows[periodKey]) {
    return PHAB_DATA.team_windows[periodKey];
  }
  return PHAB_DATA;
}

// Module-level state mutated by `renderTeamTotalView`. The no-team
// review handlers (`toggleNoTeamReviewSection`, `setNoTeamReviewOpen`,
// `buildNoTeamReviewTable`) read these so a period change updates
// their behaviour without re-binding listeners.
let s = null;
let noTeamTile = null;
let noTeamHint = null;
let noTeamReviewList = [];
let noTeamReviewChart = null;
let noTeamReviewTableBuilt = false;

function renderTeamTotalView(periodKey) {
  const view = teamViewFor(periodKey);
  s = view.summary;
  const c = view.concentration;

  // Summary grid
  const sg = document.getElementById('summary-grid');
  sg.innerHTML = '';
  sg.appendChild(stat('Total in-scope patches', s.total_patches, null,
    `All landings touching ${watched} in the selected window` +
    (excludes.length ? `, excluding ${excludes.join(', ')}` : '') +
    ', plus Lando-bot / Revert / merge / code-format commits skipped.'));
  sg.appendChild(stat('Tagged with group', s.group_tagged_patches, fmtPct(s.group_tagged_pct) + ' of total',
    `Patches whose r= line includes "${DATA.meta.group}".`));
  sg.appendChild(stat('Listed members reviewing', view.within_group_total.length, 'of ' + Object.keys(DATA.members).length + ' on the list',
    'How many listed members reviewed at least one patch in the selected window.'));
  noTeamTile = stat('Landed without team review', s.landed_without_team_review, fmtPct(s.landed_without_team_review_pct) + ' of total',
    `In-scope patches that landed with neither the ${DATA.meta.group} group tag nor any listed member as a reviewer. A non-zero value means changes in the team's paths are landing without team oversight. Click to see the per-subdirectory breakdown.`);
  noTeamTile.classList.add('expandable');
  noTeamHint = document.createElement('div');
  noTeamHint.className = 'hint';
  noTeamHint.textContent = 'Click to view breakdown';
  noTeamTile.appendChild(noTeamHint);
  noTeamTile.addEventListener('click', toggleNoTeamReviewSection);
  sg.appendChild(noTeamTile);
  sg.appendChild(stat('Avg group-tagged / week', fmtNum(s.avg_per_week), null,
    'Group-tagged patches landed per ISO week, averaged across the selected window.'));

  // Concentration grid
  const cg = document.getElementById('concentration-grid');
  cg.innerHTML = '';
  cg.appendChild(stat('Top-1 share', fmtPct(c.top1_share), null,
    'Share of all member-reviews done by the single top member.'));
  cg.appendChild(stat('Top-3 share', fmtPct(c.top3_share), null,
    'Share done by the top 3 members combined.'));
  cg.appendChild(stat('Top-5 share', fmtPct(c.top5_share), null,
    'Share done by the top 5 members combined.'));
  cg.appendChild(stat('Gini coefficient', c.gini.toFixed(2), null,
    'Inequality measure. 0 = perfectly even, 1 = one person does everything. ~0.5+ = significant concentration.'));
  cg.appendChild(stat('Bus factor (≥50%)', c.bus_factor, null,
    'Smallest number of members whose absence leaves >50% of reviews uncovered. Lower = more single-point-of-failure risk.'));

  // Charts
  renderTeamCharts(view);

  // No-team-review summary tile + lazy section
  noTeamReviewList = s.landed_without_team_review_list || [];
  document.getElementById('no-team-review-list-count').textContent = noTeamReviewList.length;
  resetNoTeamReviewSection();

  // Phab section for the same window
  renderPhabTotalView(periodKey);

  attachTooltips(document);
}

function resetNoTeamReviewSection() {
  // Collapse the nested-detail panel, throw away its lazy chart, and
  // mark the lazy table for rebuild. Called on every period change so
  // the panel doesn't carry stale rows / a stale pie across windows.
  resetChart('chart-no-team-review');
  noTeamReviewChart = null;
  noTeamReviewTableBuilt = false;
  const container = document.getElementById('no-team-review-list-container');
  if (container) container.innerHTML = '';
  const detailsEl = document.getElementById('no-team-review-list-details');
  if (detailsEl) detailsEl.open = false;
  setNoTeamReviewOpen(false);
}

// --- Weekly summary + concentration (latest week vs previous) ---
const lastIdx = DATA.weekly_trend.weeks.length - 1;
if (lastIdx >= 0) {
  const now = weekStats(lastIdx);
  const prev = lastIdx > 0 ? weekStats(lastIdx - 1) : null;
  const delta = (curr, base) => {
    if (base == null) return '';
    const d = curr - base;
    if (d === 0) return 'no change vs prev week';
    const sign = d > 0 ? '+' : '';
    return `${sign}${typeof d === 'number' && !Number.isInteger(d) ? d.toFixed(2) : d} vs prev week`;
  };
  const deltaPct = (curr, base) => {
    if (base == null) return '';
    const d = curr - base;
    if (Math.abs(d) < 0.001) return 'no change vs prev week';
    const sign = d > 0 ? '+' : '';
    return `${sign}${fmtPct(d)} vs prev week`;
  };

  document.getElementById('weekly-summary-label').textContent = now.week;
  const wsg = document.getElementById('weekly-summary-grid');
  wsg.appendChild(stat('Group-tagged reviews this week', now.total,
    delta(now.total, prev ? prev.total : null),
    'Reviews by listed members on group-tagged patches in the latest ISO week.'));
  wsg.appendChild(stat('Active members this week', `${now.active} / ${Object.keys(DATA.members).length}`,
    prev ? delta(now.active, prev.active) : '',
    'Listed members with any review activity in the latest week.'));
  wsg.appendChild(stat('Top reviewer this week',
    now.top && now.top[1] > 0 ? `${now.top[0]} (${now.top[1]})` : '—',
    null,
    'Single highest-volume member in the latest week.'));
  wsg.appendChild(stat('Top-1 share this week', fmtPct(now.topShare),
    prev ? deltaPct(now.topShare, prev.topShare) : '',
    'Top member’s share of the week’s member-reviews. Small samples — one review can swing this a lot.'));

  const wcg = document.getElementById('weekly-concentration-grid');
  wcg.appendChild(stat('Top-1 share', fmtPct(now.topShare),
    prev ? deltaPct(now.topShare, prev.topShare) : '',
    'Top member’s share for the latest week.'));
  wcg.appendChild(stat('Gini coefficient', now.gini.toFixed(2),
    prev ? delta(now.gini, prev.gini) : '',
    'Inequality (0 even, 1 one person) for the latest week. Noisy with small weekly samples — watch for sustained drift.'));
  wcg.appendChild(stat('Bus factor (≥50%)', now.busFactor,
    prev ? delta(now.busFactor, prev.busFactor) : '',
    'Bus factor computed over the latest week only.'));
  wcg.appendChild(stat('Active members', `${now.active} / ${Object.keys(DATA.members).length}`,
    prev ? delta(now.active, prev.active) : '',
    'Listed members with any review activity this week.'));
}

// Multi-axis toggle wiring: data-view (team|member|queue|recent) plus two
// secondary axes that share the same top-bar component — data-period
// (Team View: 1m|3m|total|weekly) and data-recent (Recent Changes: 1w|1m).
// Buttons declare their axis + value via data attributes; one handler per
// axis. Changing period re-renders the team-total slice; changing the
// recent window re-renders the Recent Changes list (assigned below).
let renderRecentWindow = null;
function bindToggle(axis) {
  const buttons = document.querySelectorAll(`.toggle-bar button[data-${axis}]`);
  function set(value) {
    document.body.dataset[axis] = value;
    for (const b of buttons) {
      b.classList.toggle('active', b.dataset[axis] === value);
    }
    if (axis === 'period') {
      const key = PERIOD_TO_KEY[value];
      if (key) renderTeamTotalView(key);
    } else if (axis === 'recent') {
      if (renderRecentWindow) renderRecentWindow(value);
    }
    writeHash();
  }
  for (const b of buttons) {
    b.addEventListener('click', () => set(b.dataset[axis]));
  }
  return set;
}
const setView = bindToggle('view');
const setPeriod = bindToggle('period');
const setRecent = bindToggle('recent');
const setHealth = bindToggle('health');

// Deep-linkable URLs. The hash encodes the current view and its secondary
// axis: #team/6m, #team/3m, #team/1m, #team/weekly, #member, #queue,
// #recent/1w, #recent/1m. Toggling updates the hash (replaceState — keeps
// the URL shareable without spamming history); on load and on back/forward
// the hash is applied to restore that exact state.
const PERIOD_TO_HASH = { total: '6m', '3m': '3m', '1m': '1m', weekly: 'weekly' };
const HASH_TO_PERIOD = { '6m': 'total', '3m': '3m', '1m': '1m', weekly: 'weekly' };

// Which secondary axis belongs to which view, stated once. Previously this
// mapping was an if/else chain repeated in writeHash, applyHash and the
// keyboard handler — adding Media Health updated two of the three and left
// Shift+Arrow dead in the new view, which is the failure this table prevents.
//   axis     — the data-* attribute name
//   def      — default value when the hash omits or misspells the sub-path
//   set      — the bindToggle setter
//   toHash   — optional value -> hash-token map (only Period renames its values)
//   fromHash — optional hash-token -> value map
const VIEW_SECONDARY_AXIS = {
  team:   { axis: 'period', def: 'total', set: setPeriod,
            toHash: PERIOD_TO_HASH, fromHash: HASH_TO_PERIOD },
  recent: { axis: 'recent', def: '1w', set: setRecent },
  health: { axis: 'health', def: 'metrics', set: setHealth },
};

let applyingHash = false;

function writeHash() {
  if (applyingHash) return;
  const v = document.body.dataset.view;
  let h = v;
  const secondary = VIEW_SECONDARY_AXIS[v];
  if (secondary) {
    const current = document.body.dataset[secondary.axis] || secondary.def;
    h += '/' + (secondary.toHash ? (secondary.toHash[current] || current) : current);
  }
  if (('#' + h) === location.hash) return;
  try { history.replaceState(null, '', '#' + h); }
  catch (e) { location.hash = h; }  // file:// fallback
}

function applyHash() {
  const raw = location.hash.replace(/^#/, '');
  if (!raw) return;
  const [v, sub] = raw.split('/');
  // Only switch to a view whose tab is actually present/visible.
  if (!visibleAxisValues('view').includes(v)) return;
  applyingHash = true;
  try {
    setView(v);
    const secondary = VIEW_SECONDARY_AXIS[v];
    if (secondary) {
      const mapped = secondary.fromHash ? secondary.fromHash[sub] : sub;
      // Unknown or absent sub-paths fall back to the view's default rather
      // than leaving the axis on whatever the previous view set.
      const values = visibleAxisValues(secondary.axis);
      secondary.set(values.includes(mapped) ? mapped : secondary.def);
    }
  } finally {
    applyingHash = false;
  }
}
window.addEventListener('hashchange', applyHash);

// If the report was generated before `team_views` was introduced,
// only 6m data is available — hide the 1m / 3m buttons so the user
// doesn't click them and see the same numbers as 6m. The next weekly
// refresh fills `team_views` in and the buttons reappear.
if (!DATA.team_views) {
  document.querySelectorAll(
    '.toggle-bar button[data-period="1m"], .toggle-bar button[data-period="3m"]'
  ).forEach(b => { b.style.display = 'none'; });
}

// Reports generated before the Recent Changes feed existed have no
// `recent_changes` block — hide the view button so it can't be selected
// (and so keyboard cycling skips it, since visibleAxisValues filters on
// offsetParent). The next weekly refresh fills it in and it reappears.
if (!RECENT) {
  document.querySelectorAll('.toggle-bar button[data-view="recent"]')
    .forEach(b => { b.style.display = 'none'; });
}

// Media Health is playback-only, expressed as a data gate rather than a team
// name: no roadmap payload means no tab. Same mechanism as RECENT above, so
// visibleAxisValues keeps keyboard cycling correct without extra work.
if (!ROADMAP) {
  document.querySelectorAll('.toggle-bar button[data-view="health"]')
    .forEach(b => { b.style.display = 'none'; });
}

// Initial team-total render — reads the HTML's default data-period
// (set to "total"; maps to "6m") and renders the matching slice.
// bindToggle takes over from here on every subsequent click.
renderTeamTotalView(PERIOD_TO_KEY[document.body.dataset.period] || '6m');

// ---- Media Health / Roadmap -----------------------------------------------
// The roadmap is prose, unlike every other view on this page. Rows stay
// scannable and each one expands to the authored consequence, evidence and
// details, so the reading material is opt-in rather than a wall of text.
function renderRoadmap() {
  if (!ROADMAP) return;

  // Reuse the page's escapers (escHtml for text, escAttr for attribute
  // sinks); they assume a string, so normalise nullish first.
  const esc = s => escHtml(s == null ? '' : s);
  const escA = s => escAttr(s == null ? '' : s);

  const audienceEl = document.getElementById('roadmap-audience');
  const isPublic = ROADMAP.audience === 'public';
  const withheldCount = ROADMAP.items.filter(i => (i.withheld || []).length).length;
  audienceEl.innerHTML = isPublic
    ? '<b>Public subset.</b> ' + withheldCount + ' item(s) have fields held back '
      + 'as internal. Withheld fields are marked in the expanded rows rather '
      + 'than silently omitted.'
    : '<b>Internal view.</b> Everything renders, including fields marked '
      + 'internal. This build is not for the public site.';

  document.getElementById('roadmap-summary').textContent = ROADMAP.summary || '';

  // Each aspect is a big category rendered as a card that expands into the
  // sub-categories it is made of. <details> keeps the open/closed state and
  // the keyboard and assistive-tech behaviour without any JS.
  const itemById = new Map(ROADMAP.items.map(i => [i.id, i]));

  // Items show their severity, so a node's rating can be checked against the
  // work under it rather than taken on trust.
  function itemChips(ids) {
    if (!ids || !ids.length) return '';
    return '<div class="rm-sub-items">' + ids.map(id => {
      const it = itemById.get(id);
      const imp = it ? it.impact : '';
      return '<span class="rm-tag" title="' + escA(it ? it.title : id) + '">'
        + (imp ? '<b class="rm-imp rm-' + esc(imp) + '">' + esc(imp) + '</b> ' : '')
        + esc(id) + '</span>';
    }).join('') + '</div>';
  }

  // One function for every level below the aspect. A node with children is a
  // <details> so it expands; a leaf is a plain block. Nesting is unbounded:
  // codec support needed three levels because "what plays" and "what each API
  // accepts" are different questions that a flat list was mixing together.
  // Which other engines ship what this node describes. Rendered as tail tags
  // so a card can be read as "Chrome and Safari both have this"; absent means
  // unverified rather than "they lack it too".
  // Each tag links to the per-engine support page it was verified against, so
  // the claim is checkable rather than asserted. A tag is only ever produced
  // with a proof link -- the model drops unanchored parity.
  function parityTags(list, url) {
    if (!list || !list.length) return '';
    const tags = list.map(e => 'parity-' + esc(e)).join(' ');
    const tip = list.join(' and ')
      + ' ship this and we do not — open the support page';
    if (!url) return '<span class="rm-parity-wrap">'
      + '<span class="rm-parity">' + tags + '</span></span>';
    return '<span class="rm-parity-wrap">'
      + '<a class="rm-parity" href="' + escA(url) + '" target="_blank"'
      + ' rel="noopener" title="' + escA(tip) + '"'
      + ' onclick="event.stopPropagation()">' + tags + ' \u2197</a></span>';
  }

  function nodeHead(n, expandable) {
    return '<div class="rm-node-h"><span>' + esc(n.name) + '</span>'
      + '<span>' + parityTags(n.parity, n.parity_url)
      + ' <span class="rm-rating">' + esc(n.rating) + '</span>'
      + (expandable ? ' <span class="rm-chev">\u25B8</span>' : '')
      + '</span></div>';
  }

  function insideLabel(n) {
    return n.sub.length + (n.sub.length === 1 ? ' sub-category' : ' sub-categories')
      + (n.item_count ? ' · ' + n.item_count
          + (n.item_count === 1 ? ' item' : ' items') : '');
  }

  function renderNode(n) {
    const body = '<p>' + esc(n.text) + '</p>';

    if (n.has_children) {
      return '<details class="rm-node ' + esc(n.rating) + '">'
        + '<summary>' + nodeHead(n, true) + body
        + '<div class="rm-expand">' + insideLabel(n) + '</div></summary>'
        + '<div class="rm-kids">' + n.sub.map(renderNode).join('') + '</div>'
        + '</details>';
    }

    const items = itemChips(n.rests_on);
    return '<div class="rm-node ' + esc(n.rating) + '">' + nodeHead(n, false)
      + body
      + (items || '<div class="rm-sub-none">nothing on the roadmap for this</div>')
      + '</div>';
  }

  document.getElementById('roadmap-aspects').innerHTML =
    (ROADMAP.aspects || []).map(a => {
      const subs = a.sub || [];
      const expandable = subs.length > 0;
      // No parity tag on a category card: it would carry one proof link while
      // covering several children. Tags live on the node that names the item.
      const head = '<div class="rm-aspect-h">'
        + '<span class="rm-aspect-name">' + esc(a.name) + '</span>'
        + '<span><span class="rm-rating">' + esc(a.rating) + '</span>'
        + (expandable ? ' <span class="rm-chev">\u25B8</span>' : '')
        + '</span></div>';
      const body = '<p>' + esc(a.text) + '</p>';
      if (!expandable) {
        return '<div class="rm-aspect ' + esc(a.rating) + '">'
          + '<div style="padding: 12px 16px 13px">' + head + body + '</div></div>';
      }
      return '<details class="rm-aspect ' + esc(a.rating) + '">'
        + '<summary>' + head + body
        + '<div class="rm-expand">' + insideLabel(a) + '</div></summary>'
        + '<div class="rm-kids">' + subs.map(renderNode).join('') + '</div>'
        + '</details>';
    }).join('');

  const m = ROADMAP.counts;
  const lowConf = ROADMAP.items.filter(
    i => i.bucket === 'measure' && i.confidence === 'low').length;
  document.getElementById('roadmap-measure-note').textContent =
    'Unranked, ' + m.measure + ' items. ' + lowConf + ' are low-confidence '
    + 'guesses; ' + (m.measure - lowConf) + ' are claims we are confident about '
    + 'that simply have no reach figure. Those are two different problems with '
    + 'two different next actions.';

  // The scalar metric table used to live in the Metrics subview and
  // contradicted the measured coverage matrix on the same page (claiming Safari
  // on suites Safari never ran). The Metrics subview now renders real numbers
  // from Perfherder, so only the coverage grids remain here.
  // The roadmap's hand-authored coverage grids used to render here. They are
  // superseded by the measured probe in the Metrics subview (#pm-caps): reading
  // Chromium's codec list said Chrome plays PCM and AC-3 in Matroska, and
  // shipping Chrome answers no to both. The markup for them is gone, so nothing
  // is written here -- writing to a removed element threw and took the rest of
  // this function, and renderMetrics(), down with it.

  function ownerCell(it) {
    if ((it.withheld || []).includes('owner')) {
      return '<span class="rm-dim">withheld</span>';
    }
    return it.owner
      ? esc(it.owner)
      : '<span class="rm-dim">unowned</span>';
  }

  function expansion(it) {
    let h = '';
    if (it.consequence) {
      h += '<div class="rm-exp-h">Consequence</div>'
         + '<p class="rm-exp-p">' + esc(it.consequence) + '</p>';
    }
    for (const [field, label] of [['evidence', 'Evidence'], ['details', 'Details']]) {
      if ((it.withheld || []).includes(field)) {
        h += '<div class="rm-exp-h">' + label + '</div>'
           + '<div class="rm-withheld">Withheld from the public build — '
           + 'this field is marked internal.</div>';
      } else if (it[field]) {
        h += '<div class="rm-exp-h">' + label + '</div>'
           + '<p class="rm-exp-p">' + esc(it[field]) + '</p>';
      }
    }
    h += '<div class="rm-exp-h">Attributes</div><p class="rm-exp-p">'
       + '<span class="rm-tag">' + esc(it.type) + '</span>'
       + '<span class="rm-tag">cost ' + esc(it.cost) + '</span>'
       + '<span class="rm-tag">conf ' + esc(it.confidence) + '</span>'
       + (it.demand ? '<span class="rm-tag">demand ' + esc(it.demand) + '</span>' : '')
       + (it.scope ? '<span class="rm-tag">' + esc(it.scope) + '</span>' : '')
       + (it.initiative ? '<span class="rm-tag">init: ' + esc(it.initiative) + '</span>' : '')
       + (it.tags || []).map(t => '<span class="rm-tag">' + esc(t) + '</span>').join('')
       + '</p>';
    return h;
  }

  // One column definition for all three bucket tables, so adding or resizing
  // a column is a single edit and the expansion colspan cannot drift.
  const RM_COLS = [
    ['Impact', '58px'], ['Reach', '62px'], ['Item', null],
    ['Owner', '110px'], ['Cost', '58px'], ['Conf', '60px'],
  ];
  const RM_HEAD = '<tr>' + RM_COLS.map(
    ([label, w]) => '<th' + (w ? ' style="width: ' + w + '"' : '') + '>'
      + label + '</th>').join('') + '</tr>';

  function fill(tableId, bucket) {
    const table = document.getElementById(tableId);
    table.querySelector('thead').innerHTML = RM_HEAD;
    const rows = ROADMAP.items.filter(i => i.bucket === bucket);
    table.querySelector('tbody').innerHTML =
      rows.map(it => {
        const unknownReach = !it.reach || it.reach === 'UNKNOWN';
        const search = [it.title, it.consequence, it.owner || '',
                        (it.tags || []).join(' ')].join(' ').toLowerCase();
        return '<tr class="rm-row" data-search="' + escA(search) + '">'
          + '<td><span class="rm-imp rm-' + esc(it.impact) + '">'
          + esc(it.impact) + '</span></td>'
          + '<td><span class="rm-reach' + (unknownReach ? ' unk' : '') + '">'
          + (unknownReach ? '—' : 'r' + esc(it.reach)) + '</span></td>'
          + '<td><span class="rm-title">' + esc(it.title) + '</span>'
          + '<span class="rm-cons">' + esc(it.consequence) + '</span></td>'
          + '<td>' + ownerCell(it) + '</td>'
          + '<td class="rm-mono">' + esc(it.cost) + '</td>'
          + '<td class="rm-mono rm-dim">' + esc(it.confidence) + '</td></tr>'
          + '<tr class="rm-exp rm-hidden"><td colspan="' + RM_COLS.length + '">'
          + expansion(it) + '</td></tr>';
      }).join('');
  }
  fill('roadmap-ranked', 'ranked');
  fill('roadmap-measure', 'measure');
  fill('roadmap-continuous', 'continuous');

  // fill() emits each row immediately followed by its expansion row, so the
  // pair is nextElementSibling. Resolved once here: the previous form ran a
  // full-document attribute query per row on every keystroke, which scaled
  // with the whole page (the Wait Queue alone builds hundreds of rows).
  const rmPairs = [...document.querySelectorAll('tr.rm-row')]
    .map(tr => [tr, tr.nextElementSibling]);

  for (const [tr, exp] of rmPairs) {
    tr.addEventListener('click', () => {
      if (exp) exp.classList.toggle('rm-hidden');
    });
  }

  const q = document.getElementById('roadmap-q');
  const counter = document.getElementById('roadmap-count');
  function applyFilter() {
    const t = q.value.trim().toLowerCase();
    let n = 0;
    for (const [tr, exp] of rmPairs) {
      const show = !t || tr.dataset.search.includes(t);
      tr.classList.toggle('rm-hidden', !show);
      if (exp && !show) exp.classList.add('rm-hidden');
      if (show) n++;
    }
    counter.textContent = n + ' of ' + ROADMAP.counts.total + ' shown';
  }
  q.addEventListener('input', applyFilter);
  applyFilter();
}
renderRoadmap();

// ---- Media Health / Metrics ------------------------------------------------
// Cross-browser comparison of the media Raptor metrics that actually run on
// more than one browser. Emphasis form: Firefox carries the accent, every other
// browser is context grey, because the question is where we stand rather than
// telling three series apart.
function renderMetrics() {
  if (!METRICS) return;
  const esc = s => escHtml(s == null ? '' : s);
  const escA = s => escAttr(s == null ? '' : s);
  const pct = (v, max) => max > 0 ? Math.max(0, Math.min(100, 100 * v / max)) : 0;

  // Taskcluster platform slugs are unreadable; every metric here is one machine
  // configuration and the reader has to know which.
  const PLATFORM = {
    'macosx1470-64-shippable': 'macOS 14 · Intel',
    'linux2404-64-shippable': 'Linux 24.04',
    'windows11-64-24h2-shippable': 'Windows 11',
  };
  const plat = p => PLATFORM[p] || p;

  // Fixed scale, deliberately not derived from the data: a rebased scale would
  // silently change every bar length whenever a new extreme appeared, breaking
  // week-over-week reading on a weekly-refreshed page. Anything past the top is
  // clipped and marked.
  const CAP = 4;
  const half = f => 50 * Math.min(1, (f - 1) / (CAP - 1));

  const c = METRICS.counts;
  const scopes = [...new Set(METRICS.metrics.map(m => plat(m.platform)))];
  document.getElementById('pm-lede').innerHTML =
    '<div class="pm-stats">'
    + '<div class="pm-stat"><div class="pm-stat-v">' + c.total + '</div>'
    + '<div class="pm-stat-l">metrics charted</div></div>'
    + '<div class="pm-stat"><div class="pm-stat-v">' + c.compared + '</div>'
    + '<div class="pm-stat-l">have another browser</div></div>'
    + '<div class="pm-stat"><div class="pm-stat-v">' + c.firefox_only + '</div>'
    + '<div class="pm-stat-l">Firefox only</div></div>'
    + '<div class="pm-stat"><div class="pm-stat-v">' + METRICS.window_days + 'd</div>'
    + '<div class="pm-stat-l">window</div></div></div>'
    + '<p class="pm-scope">All figures: ' + esc(scopes.join(' / '))
    + ' &middot; median of runs to '
    + esc((METRICS.generated_at || '').slice(0, 10))
    + ' &middot; compared against the strongest rival on the same suite, '
    + 'platform and codec &middot; direction normalised, so right is always '
    + 'better for Firefox</p>';

  // --- categories of expandable metric cards ---------------------------
  // One card per metric, grouped by category. Collapsed it answers "where do we
  // stand"; expanded it shows the per-browser breakdown, the exact window, and a
  // link into Perfherder's own graph for the series it was computed from -- so
  // every number on this page is checkable rather than asserted.
  //
  // Fixed scale, deliberately not derived from the data: a rebased scale would
  // silently change every bar length whenever a new extreme appeared, breaking
  // week-over-week reading on a weekly-refreshed page.
  const ticks = [1, 2, 3, 4];
  const tickRow = '<div class="pm-ticks">'
    + ticks.slice().reverse().map(t =>
        '<span style="left:' + (50 - half(t)) + '%">'
        + (t === 1 ? '1\u00D7' : t + '\u00D7') + '</span>').join('')
    + ticks.slice(1).map(t =>
        '<span style="left:' + (50 + half(t)) + '%">' + t + '\u00D7</span>').join('')
    + '</div>';

  function divergeBar(m) {
    const cmp = m.comparison;
    if (!cmp.factor) return '<div class="pm-diverge uncompared"></div>';
    const w = half(cmp.factor);
    const st = m.stale ? ' stale' : '';
    // Right = ahead. Number line, and consistent with every other bar here.
    const bar = cmp.ahead
      ? '<div class="pm-bar ahead' + st + '" style="left:50%;width:' + w + '%"></div>'
      : '<div class="pm-bar behind' + st + '" style="right:50%;width:' + w + '%"></div>';
    return '<div class="pm-diverge">' + bar + '</div>';
  }

  function verdictOf(m) {
    const cmp = m.comparison;
    if (!cmp.factor) {
      return '<span class="pm-verdict none">no other browser<br>measured yet</span>';
    }
    return '<span class="pm-verdict ' + (cmp.ahead ? 'ahead' : 'behind')
      + '"><b>' + cmp.factor.toFixed(2) + '\u00D7</b> '
      + (cmp.ahead ? 'ahead' : 'behind')
      + (cmp.factor > CAP ? ' \u2192' : '') + '<br>' + esc(cmp.versus)
      + (cmp.rival_count > 1 ? ' (best of ' + cmp.rival_count + ')' : '')
      + '</span>';
  }

  // Compact warning. The detail it stands for lives in the expansion, so the
  // collapsed row stays scannable.
  function warnIcon(m) {
    const why = [];
    if (m.stale) why.push('data is ' + m.days_behind + ' days old');
    if (m.noisy) why.push('run-to-run spread is wide');
    if (!why.length) return '';
    return '<span class="pm-warn-icon" title="' + escA(why.join('; ')
      + ' \u2014 expand for detail') + '">!</span>';
  }

  function dotRows(m) {
    const max = m.axis_max * 1.08;
    const fmt = v => max < 10 ? v.toFixed(1) : String(Math.round(v));
    const browsers = Object.keys(m.series).sort(
      (a, b) => (a === 'firefox' ? -1 : b === 'firefox' ? 1 : a.localeCompare(b)));
    const leader = browsers.reduce((best, b) =>
      best === null ? b
        : (m.lower_is_better
            ? (m.series[b].median < m.series[best].median ? b : best)
            : (m.series[b].median > m.series[best].median ? b : best)), null);
    const rows = browsers.map(b => {
      const s = m.series[b], us = b === 'firefox';
      const l = pct(s.p25, max), r = pct(s.p75, max);
      const flat = s.p75 <= s.p25;
      return '<div class="pm-plot-row' + (us ? ' us' : '') + '">'
        + '<div class="pm-browser' + (us ? ' us' : '')
        + '"><span class="pm-swatch"></span>' + esc(b) + '</div>'
        + '<div class="pm-track ' + (m.lower_is_better ? 'better-left' : 'better-right')
        + '" title="' + escA(b + ': median ' + s.median + ' ' + m.unit
            + ', p25-p75 ' + s.p25 + '-' + s.p75 + ', ' + s.n
            + ' runs, run-to-run CV ' + s.cv + '%') + '">'
        + (flat ? '' : '<div class="pm-range" style="left:' + l + '%;width:'
            + Math.max(0.4, r - l) + '%"></div>')
        + '<div class="pm-dot' + (flat ? ' nospread' : '')
        + (b === leader ? ' leader' : '')
        + '" style="left:' + pct(s.median, max) + '%"></div></div>'
        + '<div class="pm-value">'
        + (b === leader ? '<b class="pm-best">best</b> ' : '')
        + s.median + ' ' + esc(m.unit)
        + ' <span>&nbsp;n=' + s.n + ' &middot; CV ' + Math.round(s.cv)
        + '%</span></div></div>';
    }).join('');
    // Ticks always ascend left to right; direction is stated beside the unit and
    // tinted on the favourable half, never by flipping the ruler.
    const side = m.lower_is_better ? 'better-left' : 'better-right';
    const band = '<div class="pm-band"><span></span>'
      + '<div class="pm-band-in ' + side + '"><span>\u2713 better this way</span></div>'
      + '<span></span></div>';
    const axis = '<div class="pm-axis"><span></span><div class="pm-ticks">'
      + [0, 0.25, 0.5, 0.75, 1].map(f =>
          '<span style="left:' + (f * 100) + '%">' + fmt(max * f) + '</span>').join('')
      + '</div><span class="pm-axis-dir strong" style="text-align:right">'
      + esc(m.unit) + '</span></div>';
    return band + rows + axis;
  }

  function metricCard(m) {
    const facts = [];
    facts.push(m.window_days + '-day window'
      + (m.window_end ? ' ending ' + esc(m.window_end) : ''));
    if (m.stale) {
      facts.push('<b>this suite has stopped producing \u2014 the window is the '
        + 'same length, so the medians stay comparable, but it ends about '
        + m.days_behind + ' days ago</b>');
    }
    if (m.noisy) {
      facts.push('run-to-run spread here is wider than most differences worth '
        + 'detecting, so read small gaps with care');
    }
    if (m.note) facts.push(esc(m.note));
    facts.push('platform ' + esc(plat(m.platform)));

    const link = m.graph_url
      ? '<a class="pm-source" href="' + escA(m.graph_url) + '" target="_blank"'
        + ' rel="noopener" onclick="event.stopPropagation()">'
        + 'open these exact series in Perfherder \u2197</a>'
      : '<span class="pm-source none">no signature recorded \u2014 cannot link</span>';

    return '<details class="pm-card' + (m.stale ? ' is-stale' : '') + '">'
      + '<summary><div class="pm-row">'
      + '<div class="pm-row-label">' + esc(m.title) + warnIcon(m)
      + '<em class="pm-flag">expand for browsers, window and source</em></div>'
      + divergeBar(m) + verdictOf(m) + '</div></summary>'
      + '<div class="pm-card-body">'
      + '<div class="pm-plot">' + dotRows(m) + '</div>'
      + '<ul class="pm-facts"><li>' + facts.join('</li><li>') + '</li></ul>'
      + link + '</div></details>';
  }

  // Categories keep a family together -- every WebCodecs codec in one place --
  // and are ordered worst-first by their weakest member, like the roadmap cards.
  const cats = METRICS.groups.map(g => {
    const worst = Math.min(...g.metrics.map(m => {
      const c = m.comparison;
      if (!c.factor) return 99;          // uncompared sorts last
      return c.ahead ? 50 + c.factor : -c.factor;
    }));
    return { g, worst };
  }).sort((a, b) => a.worst - b.worst);

  document.getElementById('pm-cards').innerHTML =
    '<div class="pm-row pm-head">'
    + '<span class="pm-axis-dir">metric</span>'
    + '<span class="pm-axis-dir" style="text-align:center">'
    + '\u25C0 firefox behind &nbsp;|&nbsp; parity &nbsp;|&nbsp; firefox ahead \u25B6</span>'
    + '<span class="pm-axis-dir" style="text-align:right">vs</span></div>'
    + '<div class="pm-row" style="padding:0"><span></span>' + tickRow
    + '<span></span></div>'
    + cats.map(({ g }) =>
        // No direction pill here: the tinted "better this way" band inside each
        // expanded plot already says it, next to the marks it applies to.
        // Repeating it in the header was the same fact three times over.
        '<div class="pm-cat"><div class="pm-cat-h">' + esc(g.title)
        + '<span class="pm-cat-meta">'
        + '<span>' + esc(plat(g.platform)) + ' \u00B7 ' + esc(g.unit) + ' \u00B7 '
        + g.metrics.length + (g.metrics.length === 1 ? ' metric' : ' metrics')
        + '</span></span></div>'
        + g.metrics.map(metricCard).join('') + '</div>').join('');

  // --- measured codec/container support ---------------------------------
  // Container-first, because a container has a MEASURED header (the probe asks
  // the bare MIME type too) whereas a codec header could only be a derived
  // count -- and because disagreements are container-shaped in practice: WebKit
  // implements no Matroska at all, which is one fact, not twelve.
  //
  // Every probed container is shown whether or not it differs. The previous
  // disagreements-only table made WebM, MP3 and WAV vanish, so a reader could not
  // tell "tested and fine" from "never tested".
  const caps = METRICS.caps;
  const cv = caps && caps.by_container;
  if (cv && cv.containers.length) {
    // "Play/Stream/Record" was too terse to be guessable. Short label for the
    // chip, full name for the legend and the expanded tables.
    const SURF = {playback: 'Playback', streaming: 'Streaming',
                  recording: 'Recording'};
    // Name the API each column was actually measured with. They are not all the
    // same generation: playback and streaming use MediaCapabilities, which gives
    // a definite answer plus hardware-acceleration info, while recording falls
    // back to MediaRecorder because encodingInfo throws on Chrome for every
    // configuration -- driving that column with it would report Chrome as
    // recording nothing.
    const SURF_FULL = {
      playback: 'Playback \u2014 a plain <video> or <audio> element '
        + '(decodingInfo, type: file)',
      streaming: 'Streaming \u2014 adaptive streaming via Media Source '
        + 'Extensions (decodingInfo, type: media-source)',
      recording: 'Recording \u2014 capturing to a file '
        + '(MediaRecorder.isTypeSupported)',
    };
    // Words, not glyphs. A filled/half/empty circle set needed a legend to
    // decode and still read as a severity ramp, which "maybe" is not: for a bare
    // MIME type with no codecs parameter, `maybe` is the spec-correct answer --
    // the browser cannot be certain without codec information. It is not partial
    // or degraded support, so it must not look like a half-full symbol.
    const CELL = {
      yes: ['yes', 'pm-w yes', 'supported'],
      partial: ['maybe', 'pm-w maybe',
                'the browser says it may be able to play this. For a bare type '
                + 'with no codecs parameter that is the normal, correct answer'],
      no: ['no', 'pm-w no', 'not supported'],
      unknown: ['?', 'pm-w unk', 'the probe could not answer'],
    };
    // Three levels of coverage, plus the case where there is nothing to cover.
    // The previous pair behaved like a boolean: 13 of 14 read as "behind", the
    // same as 0 of 14.
    const LEVEL = {
      none:    ['no support',    'pm-b-weak'],
      partial: ['partial',       'pm-b-mixed'],
      full:    ['full support',  'pm-b-ok'],
      empty:   ['nothing to support', 'pm-b-none'],
    };
    const VERDICT = {
      gap: 'we lack it, another engine has it',
      overclaim: 'we accept it and no other engine does',
      ahead: 'we have it, another engine does not',
      parity: 'all engines agree',
      none: 'no engine supports it',
    };

    function chips(c) {
      return Object.keys(SURF).map(surf => {
        const st = c.surfaces[surf];
        if (!st || !st.rows.length) {
          return '<span class="pm-chip none">' + esc(SURF[surf])
            + ' <b>\u2013</b></span>';
        }
        // Counts what we support, not what we lack: a figure beside a status
        // badge should rise as things improve.
        const ours = st.counts.ours, sup = st.counts.supported;
        const cls = !sup ? 'none' : (ours >= sup ? 'ok'
                                     : (ours ? 'part' : 'gap'));
        const body = sup ? ours + '/' + sup : '\u2013';
        const tip = sup
          ? 'we support ' + ours + ' of the ' + sup + ' combinations at least '
            + 'one engine supports'
          : 'no engine supports any codec in this container';
        return '<span class="pm-chip ' + cls + '" title="' + escA(tip) + '">'
          + esc(SURF[surf]) + ' <b>' + body + '</b></span>';
      }).join('');
    }

    function surfaceTable(c, surf) {
      const st = c.surfaces[surf];
      if (!st || !st.rows.length) return '';
      // Grouped video / audio, worst-first, with the rows no engine supports
      // already left out by the builder. Not shown at all: nobody
      // supporting a combination is not a finding about Firefox, and the probe
      // asks every codec a container could plausibly carry, so there are many.
      const groups = st.groups || [];
      const head = '<tr><th>Codec</th><th>Codec string</th>'
        + cv.browsers.map(b => '<th style="text-align:center">'
            + esc(b.target.split('-')[0]) + '</th>').join('') + '</tr>';
      const body = r => '<tr class="pm-v-' + esc(r.verdict) + '">'
        + '<td>' + esc(r.codec) + '</td>'
        + '<td class="rm-mono" style="font-size:9.5px;color:var(--ink-soft)">'
        + esc(r.codec_string) + '</td>'
        + cv.browsers.map(b => {
            const [g, cls, tip] = CELL[r.support[b.target]] || CELL.unknown;
            // No powerEfficient / smooth chip here on purpose: both are
            // per-device, so they describe the machine that ran the probe rather
            // than the browser, which is not what a general table can say.
            return '<td class="' + cls + '" title="'
              + escA(b.label + ': ' + tip) + '">' + g + '</td>';
          }).join('')
        + '</tr>';
      return '<h4 style="margin:12px 0 3px;font-size:11.5px;'
        + 'font-family:var(--mono);text-transform:uppercase;'
        + 'letter-spacing:.07em;color:var(--ink-soft)">' + esc(SURF[surf])
        + '</h4>'
        + (groups.length
            ? groups.map(gr =>
                // Video and audio are different questions; interleaving them by
                // verdict meant reading past six audio codecs to find AV1.
                '<p class="pm-kind">' + esc(gr.label) + '</p>'
                + '<div class="table-wrap"><table><thead>' + head
                + '</thead><tbody>' + gr.rows.map(body).join('')
                + '</tbody></table></div>').join('')
            : '<p class="footer-note">No engine supports any codec here.</p>')
        ;
    }

    document.getElementById('pm-caps').innerHTML =
      '<h2>Codec and container support, measured</h2>'
      // Date only. The engines and their versions are listed immediately below,
      // so naming them here said it twice.
      + '<p class="footer-note">Measured on '
      + esc((caps.probed_at || '').slice(0, 10)) + '. '
      + '<a href="../media-capabilities/index.html" target="_blank" '
      + 'rel="noopener">Run the probe yourself \u2197</a></p>' 
      + '<ul class="pm-facts">'
      + cv.browsers.map(b => {
          const caveat = b.is_proxy_for_safari
            ? 'A WebKit build, not Safari: it lacks the platform codec '
              + 'integration Safari gets from the OS, so a "no" here is weaker '
              + 'evidence.'
            : (b.is_nonshipping_build
                ? 'A Playwright Gecko build, not a shipping Firefox '
                  + 'configuration; codec support is exactly where build flags '
                  + 'differ.'
                : '');
          // Caveat on hover rather than inline: it is real, and it was also
          // three lines of prose above the table it qualifies.
          return '<li' + (caveat ? ' title="' + escA(caveat) + '"' : '')
            + '><b>' + esc(b.name || b.label) + '</b> ' + esc(b.version)
            + (caveat ? ' <span class="pm-caveat">?</span>' : '') + '</li>';
        }).join('')
      + '</ul>'
      // One line rather than a "How to read this" list: with the chip and badge
      // bullets removed, the heading stood over a single item. The three surface
      // names are the only part a reader cannot infer from the cards.
      + '<p class="footer-note">Three surfaces per container: '
      + '<b>Playback</b> a plain media element, <b>Streaming</b> via Media '
      + 'Source, <b>Recording</b> via MediaRecorder.</p>'

      + cv.containers.map(c => {
          const [word, cls] = LEVEL[c.level] || LEVEL.partial;
          return '<details class="pm-card pm-cont"><summary>'
            + '<div class="pm-cont-h"><span class="pm-cont-n">' + esc(c.name)
            + '<small>' + (c.mimes.length ? esc(c.mimes.join(', ')) : 'no MIME type')
            + '</small></span>'
            + '<span class="pm-badge-cell"><span class="pm-badge ' + cls
            + '">' + word + '</span></span>'
            + '<span class="pm-chips">' + chips(c) + '</span>'
            + '<span class="pm-cont-n2">'
            + (c.probed
                ? c.combos + ' combination' + (c.combos === 1 ? '' : 's')
                : 'container-level probe only')
            + '</span></div></summary>'
            + '<div class="pm-card-body">'
            + (c.probed
                ? Object.keys(SURF).map(sf => surfaceTable(c, sf)).join('')
                : '<p class="footer-note">No codec combinations were probed for '
                  + 'this container \u2014 only whether the container itself is '
                  + 'accepted.</p>')
            + '</div></details>';
        }).join('')
      ;
  }

}
renderMetrics();

// Keyboard navigation mirroring the toggle bar:
//   Left / Right         → cycle the view axis (Team → Member → Wait Queue)
//   Shift + Left / Right → cycle the period axis (Team View only)
// Shift is the period modifier rather than Ctrl: Ctrl+Arrow is the macOS
// Spaces switch, which the OS grabs before the page sees it. Ordered
// values come from the *visible* buttons, so hidden options (e.g. 1m /
// 3m on legacy reports) are skipped without special-casing.
function visibleAxisValues(axis) {
  return Array.from(
    document.querySelectorAll(`.toggle-bar button[data-${axis}]`)
  ).filter(b => b.offsetParent !== null).map(b => b.dataset[axis]);
}
function cycleValue(values, current, dir) {
  const i = values.indexOf(current);
  if (i === -1) return values[0];
  return values[(i + dir + values.length) % values.length];
}
function isTypingTarget(el) {
  if (!el) return false;
  const tag = el.tagName;
  return tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA' ||
         el.isContentEditable;
}
document.addEventListener('keydown', (e) => {
  if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
  // Leave OS/browser-reserved combos alone: Cmd/Meta (back-forward),
  // Alt (word motion), Ctrl (macOS Spaces switch). Shift is ours.
  if (e.metaKey || e.altKey || e.ctrlKey) return;
  if (isTypingTarget(e.target)) return;
  const dir = e.key === 'ArrowRight' ? 1 : -1;
  if (e.shiftKey) {
    // Shift+arrow drives the secondary axis of the current view: the period
    // in Team View, the week/month window in Recent Changes, the section in
    // Media Health. One table so a new view cannot be added to the toggle bar
    // and the hash while silently having dead keyboard navigation — which is
    // exactly what happened when Media Health was first wired up.
    const secondary = VIEW_SECONDARY_AXIS[document.body.dataset.view];
    if (secondary) {
      const values = visibleAxisValues(secondary.axis);
      secondary.set(cycleValue(values, document.body.dataset[secondary.axis], dir));
    }
  } else {
    const values = visibleAxisValues('view');
    setView(cycleValue(values, document.body.dataset.view, dir));
  }
  e.preventDefault();
});

function horizontalBar(canvasId, rows, fill) {
  const colors = (typeof fill === 'function')
    ? rows.map((_, i) => fill(i))
    : rows.map(() => fill);
  return new Chart(document.getElementById(canvasId), {
    type: 'bar',
    data: {
      labels: rows.map(r => r.name),
      datasets: [{
        data: rows.map(r => r.count),
        backgroundColor: colors,
      }],
    },
    options: {
      indexAxis: 'y',
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: {
          label: ctx => {
            const row = rows[ctx.dataIndex];
            return row.pct != null
              ? `${row.count} (${fmtPct(row.pct)})`
              : `${row.count}`;
          },
        }},
      },
      scales: { x: { beginAtZero: true } },
      maintainAspectRatio: false,
    },
  });
}

