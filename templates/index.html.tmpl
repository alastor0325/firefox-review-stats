<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Team Dashboard</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='12' fill='%23FF0039'/><text x='32' y='49' font-family='-apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif' font-weight='900' font-size='52' fill='white' text-anchor='middle'>m</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..900,0..100;1,9..144,300..900,0..100&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400..700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  :root {
    --paper: #FAF7F0;
    --paper-warm: #F2EBDC;
    --ink: #16110D;
    --ink-soft: #3B342D;
    --muted: #8B8378;
    --rule: #E6DECD;
    --rule-soft: #F0E9D9;
    --surface: #FFFFFF;
    --red: #FF0039;
    --red-deep: #B3002A;

    /* legacy token aliases retained in case any inline reference uses them */
    --bg: var(--paper);
    --fg: var(--ink);
    --card: var(--surface);
    --accent: var(--red);
    --warn: var(--red);
    --pill: var(--paper-warm);
    --pill-active: var(--ink);
    --pill-active-fg: var(--paper);

    --serif: 'Fraunces', 'Iowan Old Style', Georgia, serif;
    --sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
  }
  * { box-sizing: border-box; }

  body {
    font-family: var(--sans);
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* Sticky top bar — header + view selector pinned together */
  .top-bar {
    position: sticky; top: 0; z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  header {
    padding: 22px 40px 10px;
    max-width: 1200px;
    margin: 0 auto;
  }
  header h1 {
    margin: 0;
    font-family: var(--serif);
    font-variation-settings: "opsz" 90, "wght" 500, "SOFT" 30;
    font-size: 32px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--ink);
  }
  header h1 a {
    color: var(--muted) !important;
    text-decoration: none !important;
    opacity: 1 !important;
    font-family: var(--serif);
    font-variation-settings: "opsz" 60, "wght" 400;
    font-size: 22px;
    margin-right: 12px !important;
    vertical-align: 3px;
    font-weight: 400 !important;
    transition: color 0.15s;
    display: inline-block;
  }
  header h1 a:hover { color: var(--red) !important; }
  /* The title is plain heading text (the repo link now lives in the
     fixed GitHub corner, top-right). Keep it visually identical to the
     heading rather than the small muted back-arrow. */
  header h1 .dash-title {
    color: var(--ink) !important;
    font-size: inherit !important;
    font-weight: 500 !important;
    font-variation-settings: "opsz" 90, "wght" 500, "SOFT" 30;
    margin-right: 0 !important;
    vertical-align: baseline;
  }
  /* Small GitHub mark fixed top-right — markup + CSS shared with the
     landing picker via reviewstats/ui.py (injected at render time). */
  __GH_CORNER_CSS__
  header h1 #header-group {
    font-style: italic;
    color: var(--red);
    font-variation-settings: "opsz" 90, "wght" 500, "SOFT" 100;
    letter-spacing: -0.005em;
  }
  header .meta {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: uppercase;
    line-height: 1.65;
  }

  /* View / period selector — text tabs with red underline */
  .toggle-bar {
    display: flex; align-items: baseline;
    max-width: 1200px; margin: 0 auto;
    padding: 8px 40px 8px;
  }
  .toggle-group { display: flex; }
  .toggle-sep {
    width: 1px; height: 11px;
    background: var(--rule);
    margin: 5px 14px;
    align-self: center;
  }
  .toggle-bar button {
    background: transparent;
    color: var(--muted);
    border: none;
    padding: 4px 0;
    margin-right: 20px;
    font: inherit;
    font-family: var(--mono);
    font-size: 10.5px; font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    position: relative;
    transition: color 0.15s;
  }
  .toggle-bar button::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }
  .toggle-bar button:hover { color: var(--ink); }
  .toggle-bar button.active {
    color: var(--ink);
    font-weight: 600;
  }
  .toggle-bar button.active::after { transform: scaleX(1); }

  main {
    max-width: 1200px; margin: 0 auto;
    padding: 18px 40px 48px;
  }

  /* Page divider — used for the inline phab-section H2 dividers */
  .page-divider {
    font-family: var(--serif);
    font-variation-settings: "opsz" 60, "wght" 500, "SOFT" 30;
    font-size: 22px;
    line-height: 1.2;
    margin: 24px 0 10px;
    padding: 0;
    color: var(--ink);
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .page-divider em {
    font-style: italic;
    color: var(--red);
    font-variation-settings: "opsz" 60, "wght" 500, "SOFT" 100;
  }

  section {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 16px 20px 18px;
    margin-bottom: 10px;
    position: relative;
  }
  section h2 {
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule-soft);
    font-family: var(--serif);
    font-variation-settings: "opsz" 30, "wght" 600, "SOFT" 30;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  section h2 .info { vertical-align: middle; }

  /* Small marginal § marker beside each section, like a printed footnote */
  section::before {
    content: '§';
    position: absolute;
    left: -30px; top: 12px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 22px;
    color: var(--rule);
    font-variation-settings: "opsz" 30, "wght" 400, "SOFT" 100;
    line-height: 1;
  }
  @media (max-width: 1340px) { section::before { display: none; } }

  /* Stats grid — bordered tiles using gap+background hairline trick */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .stat {
    padding: 11px 14px 13px;
    background: var(--surface);
    position: relative;
  }
  .stat .label {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    line-height: 1.4;
  }
  .stat .value {
    font-family: var(--serif);
    font-variation-settings: "opsz" 72, "wght" 500, "SOFT" 20;
    font-size: 26px;
    line-height: 1;
    margin-top: 6px;
    letter-spacing: -0.022em;
    font-weight: 500;
    color: var(--ink);
    font-feature-settings: "tnum", "lnum";
  }
  .stat .sub {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted);
    margin-top: 5px;
    letter-spacing: 0.02em;
    line-height: 1.45;
  }
  .stat.expandable {
    cursor: pointer;
    transition: background 0.15s;
  }
  .stat.expandable:hover { background: var(--paper); }
  .stat.expandable .label::after {
    content: " →";
    color: var(--red);
    font-size: 10px;
    display: inline-block;
    transition: transform 0.2s;
    font-weight: 700;
    margin-left: 4px;
  }
  .stat.expandable.is-open { background: var(--paper-warm); }
  .stat.expandable.is-open .label::after { transform: rotate(90deg); }
  .stat.expandable .hint {
    font-family: var(--mono);
    font-size: 8.5px;
    color: var(--red);
    margin-top: 5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  /* Nested detail (subdir breakdown) — appears below summary tiles */
  .nested-detail {
    margin: 0 0 10px;
    padding: 14px 20px 16px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: 0 2px 2px 0;
    position: relative;
  }
  .nested-detail h3 {
    font-family: var(--serif);
    font-variation-settings: "opsz" 24, "wght" 600;
    font-size: 14px;
    margin: 0 0 10px;
    font-weight: 600;
    color: var(--ink);
  }
  .nested-detail .chart-box.square { max-width: 300px; margin: 0 auto; }
  .nested-detail .close-detail {
    position: absolute; top: 12px; right: 14px;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9.5px; padding: 4px 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .nested-detail .close-detail:hover {
    border-color: var(--red); color: var(--red);
  }

  /* Sub-details — expandable table-of-patches list */
  .sub-details {
    margin: 12px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid var(--rule);
  }
  .sub-details > summary {
    cursor: pointer;
    font-family: var(--mono);
    font-size: 11px; font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    list-style: none;
    user-select: none;
    padding: 4px 0;
  }
  .sub-details > summary::-webkit-details-marker { display: none; }
  .sub-details > summary::before {
    content: "▸ "; color: var(--red);
    display: inline-block;
    transition: transform 0.15s;
    width: 1em;
  }
  .sub-details[open] > summary::before { content: "▾ "; }
  .sub-details table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 14px;
    font-family: var(--sans);
    font-size: 12.5px;
  }
  .sub-details th, .sub-details td {
    text-align: left;
    padding: 9px 10px;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }
  .sub-details th {
    background: var(--paper);
    font-family: var(--mono);
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    font-size: 9.5px;
    letter-spacing: 0.1em;
  }
  .sub-details td.subject { max-width: 380px; overflow-wrap: anywhere; }
  .sub-details td.subdir-cell {
    font-family: var(--mono);
    color: var(--red-deep);
    font-size: 11.5px;
    white-space: nowrap;
  }

  /* Back to top — fixed bottom right */
  #back-to-top {
    position: fixed;
    bottom: 28px; right: 28px;
    width: 44px; height: 44px;
    border-radius: 2px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: 18px; line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(22, 17, 13, 0.18);
    opacity: 0; visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s,
                background 0.18s, border-color 0.18s;
    z-index: 200;
  }
  #back-to-top.is-visible {
    opacity: 1; visibility: visible;
    transform: translateY(0);
  }
  #back-to-top:hover {
    background: var(--red);
    border-color: var(--red);
  }
  #back-to-top:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  /* Chart boxes */
  .chart-box { position: relative; height: 280px; }
  .chart-box.tall { height: 380px; }
  .chart-box.square { height: 280px; max-width: 420px; margin: 0 auto; }
  .split { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; align-items: center; }
  @media (max-width: 800px) { .split { grid-template-columns: 1fr; } }

  /* Tables */
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 12.5px;
    table-layout: fixed;
  }
  th, td {
    text-align: left;
    padding: 7px 10px;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }
  th {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--rule);
  }
  th.num, td.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-family: var(--mono);
  }
  #queue-table td.title { word-break: break-word; overflow-wrap: anywhere; }

  /* ---- Media Health / Roadmap -------------------------------------- */
  /* The roadmap's substance is authored prose, not numbers, so rows stay
     scannable and the paragraphs live behind a click. */
  .rm-imp {
    font-family: var(--mono); font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.04em;
  }
  .rm-S1 { color: var(--red); }
  .rm-S2 { color: var(--red-deep); }
  .rm-S3 { color: var(--ink-soft); }
  .rm-S4 { color: var(--muted); }
  .rm-reach { font-family: var(--mono); font-size: 10.5px; color: var(--ink-soft); }
  .rm-reach.unk { color: var(--muted); }
  tr.rm-row { cursor: pointer; }
  tr.rm-row:hover td { background: var(--paper); }
  .rm-title { font-weight: 500; line-height: 1.45; }
  .rm-cons {
    display: block; color: var(--muted); font-size: 11.5px;
    line-height: 1.5; margin-top: 3px;
  }
  tr.rm-exp > td {
    background: var(--surface); padding: 12px 14px 15px;
    border-bottom: 1px solid var(--rule);
  }
  .rm-exp-h {
    font-family: var(--mono); font-size: 9.5px; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--muted); font-weight: 600;
    margin: 0 0 4px;
  }
  .rm-exp-p {
    margin: 0 0 11px; font-size: 12.5px; line-height: 1.65;
    max-width: 88ch; color: var(--ink-soft);
  }
  .rm-withheld {
    background: var(--paper-warm); border-left: 2px solid var(--muted);
    padding: 7px 11px; margin: 0 0 11px;
    font-family: var(--mono); font-size: 10.5px; color: var(--muted);
    line-height: 1.55;
  }
  .rm-tag {
    font-family: var(--mono); font-size: 9px; color: var(--muted);
    border: 1px solid var(--rule); border-radius: 3px; padding: 1px 4px;
    margin: 0 3px 3px 0; display: inline-block;
  }
  .rm-pill {
    font-family: var(--mono); font-size: 9px; text-transform: uppercase;
    letter-spacing: 0.07em; padding: 2px 6px; border-radius: 9px;
    background: var(--paper-warm); color: var(--ink-soft);
    white-space: nowrap; display: inline-block;
  }
  .rm-pill.tbd { background: var(--red); color: #fff; }
  /* Rating colours, declared once and read by all three places a rating is
     shown: the aspect's left stripe, the rating chip at every level, and the
     dot on the spine. `unknown` is deliberately not the same amber as `mixed`:
     "we cannot answer this" is a different statement from "partly fine", and
     colouring them alike hid that. */
  :root {
    --rate-good: #2E7D4F;
    --rate-mixed: #C4890A;
    --rate-weak: #B3002A;
    --rate-unknown: #6B7B8C;
  }

  /* Condition tree. Single column, full content width: three levels of
     nesting need horizontal room, and in a two-column grid expanding one card
     resizes its row and visibly shifts the unrelated card beside it. */
  .rm-aspects {
    display: block; margin: 4px 0 18px;
    border: 1px solid var(--rule); background: var(--surface);
  }
  .rm-aspect {
    border-bottom: 1px solid var(--rule);
    border-left: 3px solid var(--rule);
  }
  .rm-aspect:last-child { border-bottom: 0; }
  .rm-aspect.good { border-left-color: var(--rate-good); }
  .rm-aspect.mixed { border-left-color: var(--rate-mixed); }
  .rm-aspect.weak { border-left-color: var(--rate-weak); }
  .rm-aspect.unknown { border-left-color: var(--rate-unknown); }
  .rm-aspect > summary {
    list-style: none; cursor: pointer; padding: 12px 16px 13px; display: block;
  }
  .rm-aspect > summary::-webkit-details-marker { display: none; }
  .rm-aspect > summary:hover { background: var(--paper); }
  .rm-aspect-h {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 10px; margin-bottom: 4px;
  }
  .rm-aspect-name {
    font-family: var(--serif);
    font-variation-settings: "opsz" 90, "wght" 500, "SOFT" 20;
    font-size: 15px; letter-spacing: -0.01em;
  }
  .rm-aspect > summary > p {
    margin: 0; font-size: 12px; line-height: 1.55; color: var(--muted);
    max-width: 92ch;
  }
  .rm-rating {
    font-family: var(--mono); font-size: 8.5px; text-transform: uppercase;
    letter-spacing: 0.09em; font-weight: 700; color: var(--muted);
    white-space: nowrap;
  }
  .good > summary .rm-rating, .good > .rm-node-h .rm-rating,
  .rm-aspect.good > summary .rm-rating { color: var(--rate-good); }
  .mixed > summary .rm-rating, .mixed > .rm-node-h .rm-rating,
  .rm-aspect.mixed > summary .rm-rating { color: var(--rate-mixed); }
  .weak > summary .rm-rating, .weak > .rm-node-h .rm-rating,
  .rm-aspect.weak > summary .rm-rating { color: var(--rate-weak); }
  .unknown > summary .rm-rating, .unknown > .rm-node-h .rm-rating,
  .rm-aspect.unknown > summary .rm-rating { color: var(--rate-unknown); }
  /* Expand affordance. Two signals, both only present when there is something
     to open: a chevron in the header row, and a line saying what is inside.
     A leaf has neither and shows its items directly, so expandable and
     terminal rows are never ambiguous. */
  .rm-chev {
    font-family: var(--mono); font-size: 11px; line-height: 1;
    color: var(--muted); transition: transform 0.14s; display: inline-block;
    transform-origin: 50% 50%;
  }
  details[open] > summary .rm-chev { transform: rotate(90deg); color: var(--ink); }
  summary:hover .rm-chev { color: var(--ink); }
  .rm-expand {
    margin-top: 7px; font-family: var(--mono); font-size: 8.5px;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
  }
  details[open] > summary .rm-expand { color: var(--ink); }
  /* Parity tail tags: which other engines ship what we are missing. */
  .rm-parity {
    font-family: var(--mono); font-size: 8px; letter-spacing: 0.05em;
    text-transform: uppercase; padding: 1px 5px; border-radius: 8px;
    border: 1px solid var(--rule); color: var(--muted);
    background: var(--paper); white-space: nowrap;
  }
  .rm-parity-wrap { display: inline-flex; gap: 3px; margin-left: 2px; }
  a.rm-parity { text-decoration: none; }
  a.rm-parity:hover {
    border-color: var(--ink); color: var(--ink); background: var(--surface);
  }

  /* Every level below the aspect. Nesting is DOM-nested, so one margin rule
     compounds into the indent per level. */
  .rm-kids { background: var(--paper); }
  .rm-aspect > .rm-kids { border-top: 1px solid var(--rule); padding: 4px 0; }
  .rm-node {
    position: relative; margin-left: 22px; padding: 8px 16px 9px 14px;
    border-left: 1px solid var(--rule);
  }
  .rm-node > summary {
    list-style: none; cursor: pointer; display: block; margin: -8px -16px -9px -14px;
    padding: 8px 16px 9px 14px;
  }
  .rm-node > summary::-webkit-details-marker { display: none; }
  .rm-node > summary:hover { background: var(--paper-warm); }
  /* Elbow from the spine to this node, and a rating dot sitting on the spine. */
  .rm-node::before {
    content: ""; position: absolute; left: 0; top: 16px;
    width: 9px; height: 1px; background: var(--rule);
  }
  .rm-node::after {
    content: ""; position: absolute; left: -3.5px; top: 12.5px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--rule); border: 1px solid var(--paper);
  }
  .rm-node.good::after { background: var(--rate-good); }
  .rm-node.mixed::after { background: var(--rate-mixed); }
  .rm-node.weak::after { background: var(--rate-weak); }
  .rm-node.unknown::after { background: var(--rate-unknown); }
  .rm-node-h {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 8px; font-size: 12px; font-weight: 600; margin-bottom: 3px;
  }
  .rm-node p {
    margin: 0; font-size: 11px; line-height: 1.5; color: var(--muted);
    max-width: 88ch;
  }
  /* Deeper levels read as detail, not as peers of their parent. */
  .rm-node .rm-node .rm-node-h { font-weight: 500; font-size: 11.5px; }
  .rm-sub-items { margin-top: 5px; display: flex; flex-wrap: wrap; gap: 3px; }
  .rm-sub-none {
    font-family: var(--mono); font-size: 8.5px; color: var(--muted);
    letter-spacing: 0.03em; margin-top: 5px;
  }
  .rm-audience {
    background: var(--paper-warm); border-left: 2px solid var(--red);
    padding: 9px 13px; margin: 0 0 16px; font-size: 12px;
    line-height: 1.55; color: var(--ink-soft);
  }
  .rm-controls { display: flex; gap: 8px; align-items: center; margin: 0 0 14px; }
  .rm-controls input {
    flex: 1; min-width: 210px; padding: 6px 9px; border: 1px solid var(--rule);
    background: var(--surface); color: var(--ink); font: inherit; font-size: 12px;
  }
  .rm-count { font-family: var(--mono); font-size: 10px; color: var(--muted); }
  .rm-mono { font-family: var(--mono); font-size: 10.5px; }
  .rm-dim { color: var(--muted); }
  /* Coverage grid. Narrow fixed columns so a 13-codec matrix still fits, and
     a glyph rather than a word per cell so the shape is readable at a glance. */
  table.rm-mx { table-layout: auto; }
  table.rm-mx th.rm-mx-col {
    font-family: var(--mono); font-size: 9px; text-transform: none;
    letter-spacing: 0; text-align: center; padding: 5px 4px; white-space: nowrap;
  }
  table.rm-mx th.rm-mx-row {
    font-family: var(--sans); font-size: 12px; font-weight: 600;
    text-transform: none; letter-spacing: 0; color: var(--ink);
    white-space: nowrap; padding-right: 12px;
  }
  td.rm-mx-cell, span.rm-mx-cell {
    text-align: center; font-size: 13px; line-height: 1; padding: 6px 4px;
  }
  span.rm-mx-cell { padding: 0 2px; }
  .rm-cell-yes { color: var(--rate-good); }
  .rm-cell-hw  { color: var(--rate-mixed); }
  .rm-cell-no  { color: var(--rule); }
  /* ---- Metrics: cross-browser comparison ---------------------------- */
  /* Emphasis form: Firefox is the subject, other browsers are context. One
     accent plus grey, not a three-hue categorical palette -- the question is
     "where do we stand", not "tell three series apart".
     `--pm-behind` is deliberately NOT the Firefox accent: sharing a hex made
     every Firefox mark render in the colour that elsewhere means "losing". */
  :root {
    --pm-us: var(--red-deep);
    --pm-them: #6E675E;            /* context grey, AA against white */
    /* Split on lightness, not only hue: the previous green/brown pair measured
       1.08:1 against each other and merged under deuteranopia. Neither is the
       Firefox accent, which would otherwise paint winning marks in the colour
       that means losing. */
    --pm-ahead: #1E6B3A;           /* dark green, L* ~40 */
    --pm-behind: #E0A03C;          /* light amber,  L* ~70 */
  }
  .pm-stats {
    display: flex; gap: 26px; flex-wrap: wrap; margin: 2px 0 12px;
  }
  .pm-stat .pm-stat-v {
    font-family: var(--serif); font-size: 22px; line-height: 1;
    font-variation-settings: "opsz" 72, "wght" 500, "SOFT" 20;
  }
  .pm-stat .pm-stat-l {
    font-family: var(--mono); font-size: 9px; text-transform: uppercase;
    letter-spacing: 0.09em; color: var(--ink-soft); margin-top: 4px;
  }
  .pm-scope {
    font-family: var(--mono); font-size: 10px; color: var(--ink-soft);
    letter-spacing: 0.03em; margin: 0 0 10px;
  }
  .pm-row {
    display: grid; grid-template-columns: 210px minmax(0, 1fr) 150px;
    align-items: center; gap: 10px;
    padding: 8px 0; border-bottom: 1px solid var(--rule-soft);
  }
  .pm-row:last-child { border-bottom: 0; }
  .pm-row-label { font-size: 12.5px; font-weight: 500 }
  .pm-row-label small {
    display: block; color: var(--ink-soft); font-weight: 400; font-size: 10.5px;
  }
  .pm-row-label em {
    display: block; font-size: 10px; color: var(--ink-soft); font-style: normal;
  }
  /* Diverging track: parity is the centre, RIGHT is better for us — the number
     line, and consistent with every other bar on this page growing rightward.
     Direction is normalised upstream so one reading works for every row. Scale is
     FIXED, not data-derived: a rebased scale would change every bar length week
     to week. */
  .pm-diverge {
    position: relative; height: 22px;
    background: linear-gradient(var(--rule-soft), var(--rule-soft)) center/1px 100% no-repeat;
  }
  .pm-bar { position: absolute; top: 5px; height: 12px; border-radius: 3px;
            min-width: 3px; }
  .pm-bar.ahead { background: var(--pm-ahead) }
  .pm-bar.behind { background: var(--pm-behind) }
  .pm-diverge.uncompared {
    background: repeating-linear-gradient(135deg, var(--paper-warm) 0 4px,
                var(--surface) 4px 8px);
    border-radius: 3px;
  }
  .pm-ticks { position: relative; height: 12px }
  .pm-ticks span {
    position: absolute; transform: translateX(-50%);
    font-family: var(--mono); font-size: 9px; color: var(--ink-soft);
  }
  .pm-verdict {
    font-family: var(--mono); font-size: 11px; text-align: right;
    white-space: nowrap; color: var(--ink-soft);
  }
  .pm-verdict b { font-variant-numeric: tabular-nums; font-size: 12px }
  .pm-verdict.ahead b { color: var(--pm-ahead) }
  .pm-verdict.behind b { color: var(--pm-behind) }
  .pm-verdict.none { font-size: 10px }
  .pm-flag {
    font-family: var(--mono); font-size: 8.5px; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--ink-soft);
  }
  /* Compact warning in the collapsed row; the detail it stands for is in the
     expansion, so the row stays scannable. */
  .pm-warn-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 14px; height: 14px; margin-left: 6px; border-radius: 50%;
    background: var(--rate-mixed); color: #fff; font-weight: 700;
    font-size: 10px; font-family: var(--mono); vertical-align: middle;
    cursor: help;
  }
  .pm-card.is-stale > summary .pm-diverge { opacity: 0.72 }

  /* Expandable metric card, mirroring the roadmap tree so both subviews of
     Media Health behave the same way. */
  .pm-cat { margin: 0 0 16px }
  .pm-cat-h {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 12px; padding: 6px 0 4px; border-bottom: 1px solid var(--rule);
    font-family: var(--serif); font-size: 14px;
    font-variation-settings: "opsz" 90, "wght" 500, "SOFT" 20;
  }
  .pm-cat-meta {
    font-family: var(--mono); font-size: 9px; text-transform: uppercase;
    letter-spacing: 0.07em; color: var(--ink-soft); font-weight: 400;
    display: flex; align-items: center; gap: 8px;
  }
  .pm-card { border-bottom: 1px solid var(--rule-soft) }
  .pm-card:last-child { border-bottom: 0 }
  .pm-card > summary { list-style: none; cursor: pointer }
  .pm-card > summary::-webkit-details-marker { display: none }
  .pm-card > summary:hover { background: var(--paper) }
  .pm-card > summary .pm-row { border-bottom: 0 }
  .pm-card > summary .pm-flag::before { content: "\25B8 " }
  .pm-card[open] > summary .pm-flag::before { content: "\25BE " }
  .pm-card-body {
    padding: 4px 0 14px 12px; margin-left: 6px;
    border-left: 1px solid var(--rule);
  }
  .pm-facts {
    margin: 10px 0 8px; padding-left: 16px; font-size: 11.5px;
    line-height: 1.6; color: var(--ink-soft);
  }
  .pm-facts b { color: var(--ink) }
  .pm-source {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.03em;
  }
  .pm-source.none { color: var(--ink-soft) }
  .pm-head { border-bottom: 1px solid var(--rule); padding-bottom: 2px }
  .pm-bar.stale {
    background-image: repeating-linear-gradient(135deg,
      rgba(255,255,255,.55) 0 3px, transparent 3px 6px);
  }
  @media (max-width: 820px) { .pm-card-body { padding-left: 4px; margin-left: 0 } }

  /* Dot plot: median dot on a p25-p75 range, one row per browser. */
  .pm-plot { margin: 8px 0 2px }
  .pm-plot-row {
    display: grid; grid-template-columns: 130px minmax(0, 1fr) 190px;
    align-items: center; gap: 10px; padding: 4px 0;
  }
  .pm-browser {
    font-family: var(--mono); font-size: 10.5px; display: flex;
    align-items: center; gap: 5px; color: var(--ink-soft);
  }
  .pm-swatch {
    width: 9px; height: 9px; border-radius: 50%; flex: none;
    background: var(--pm-them);
  }
  .pm-browser.us { color: var(--ink); font-weight: 600 }
  .pm-browser.us .pm-swatch { background: var(--pm-us) }
  /* Gridlines at the tick positions, so a dot can be read against something. */
  .pm-track {
    position: relative; height: 18px;
    background:
      linear-gradient(var(--rule-soft), var(--rule-soft)) 0/1px 100% no-repeat,
      linear-gradient(var(--rule-soft), var(--rule-soft)) 25%/1px 100% no-repeat,
      linear-gradient(var(--rule-soft), var(--rule-soft)) 50%/1px 100% no-repeat,
      linear-gradient(var(--rule-soft), var(--rule-soft)) 75%/1px 100% no-repeat,
      linear-gradient(var(--rule-soft), var(--rule-soft)) 100%/1px 100% no-repeat;
  }
  .pm-range {
    position: absolute; top: 8px; height: 3px; min-width: 2px;
    background: var(--pm-them); opacity: 0.75; border-radius: 2px;
  }
  .pm-dot {
    position: absolute; top: 5px; width: 9px; height: 9px; border-radius: 50%;
    background: var(--pm-them); margin-left: -4.5px;
    box-shadow: 0 0 0 2px var(--surface);
  }
  /* A faint tint on the favourable half. This is the piece that carries
     direction without moving a single value: the tint flips per metric, the
     numbers never do. */
  .pm-track.better-left::before, .pm-track.better-right::before {
    content: ""; position: absolute; top: 0; bottom: 0; width: 50%;
    background: var(--pm-ahead); opacity: 0.11;
  }
  .pm-track.better-left::before { left: 0; border-right: 1px dashed var(--rule) }
  .pm-track.better-right::before { right: 0; border-left: 1px dashed var(--rule) }
  /* Band label, so the tint is not left to be inferred. */
  .pm-band {
    display: grid; grid-template-columns: 130px minmax(0, 1fr) 190px; gap: 10px;
  }
  .pm-band-in {
    position: relative; height: 12px; font-family: var(--mono); font-size: 8.5px;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--pm-ahead);
    font-weight: 700;
  }
  .pm-band-in span { position: absolute; top: 0 }
  .pm-band-in.better-left span { left: 2px }
  .pm-band-in.better-right span { right: 2px }
  .pm-dot.leader { box-shadow: 0 0 0 2px var(--surface), 0 0 0 3.5px var(--pm-ahead) }
  .pm-best {
    font-family: var(--mono); font-size: 8.5px; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--pm-ahead); font-weight: 700;
  }
  .pm-dot.nospread { background: var(--surface); border: 2px solid var(--pm-them) }
  .pm-plot-row.us .pm-range { background: var(--pm-us) }
  .pm-plot-row.us .pm-dot { background: var(--pm-us) }
  .pm-plot-row.us .pm-dot.nospread { background: var(--surface);
    border-color: var(--pm-us) }
  .pm-value {
    font-family: var(--mono); font-size: 11px; text-align: right;
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .pm-value span { color: var(--ink-soft); font-size: 10px }
  .pm-axis {
    display: grid; grid-template-columns: 130px minmax(0, 1fr) 190px; gap: 10px;
  }
  .pm-axis-dir {
    font-family: var(--mono); font-size: 9px; color: var(--ink-soft);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .pm-axis-dir.strong { color: var(--ink); font-weight: 700; font-size: 9.5px }
  .pm-warn {
    background: var(--paper-warm); border-left: 2px solid var(--rate-mixed);
    padding: 7px 11px; margin: 6px 0 0; font-size: 11.5px; line-height: 1.5;
    color: var(--ink-soft);
  }
  .pm-legend {
    font-family: var(--mono); font-size: 9.5px; color: var(--ink-soft);
    margin: 6px 0 0;
  }
  /* Container cards: one per container, three surface chips in the header. */
  /* Fixed tracks, not `auto`. Each card is its own grid, and an `auto` track
     sizes against that card's content only -- so nine cards produced nine
     different column widths and the badges and chips came out ragged. */
  .pm-cont-h {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px 372px 104px;
    align-items: center; gap: 12px; padding: 9px 4px;
  }
  /* The pill varies in width ("partial" vs "full support"); pinning its right
     edge keeps a constant gutter to the chip column. */
  .pm-badge-cell { justify-self: end }
  .pm-cont-n { font-size: 13px; font-weight: 600 }
  .pm-cont-n small {
    display: block; font-family: var(--mono); font-size: 9px;
    color: var(--ink-soft); font-weight: 400;
  }
  .pm-cont-n2 {
    font-family: var(--mono); font-size: 9px; color: var(--ink-soft);
    text-align: right; white-space: nowrap;
  }
  .pm-badge {
    font-family: var(--mono); font-size: 8.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em; padding: 2px 6px;
    border-radius: 3px; white-space: nowrap; color: #fff;
  }
  /* Three coverage levels, on the roadmap's rating ramp so the same idea wears
     the same colour across the page. */
  .pm-b-weak { background: var(--rate-weak) }
  .pm-b-mixed { background: var(--rate-mixed); color: var(--ink) }
  .pm-b-ok { background: var(--rate-good) }
  .pm-b-none { background: var(--muted) }
  /* Equal columns so Playback / Streaming / Recording line up regardless of
     label length or whether the figure is "10/14" or a dash. */
  .pm-chips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px }
  .pm-chip {
    font-family: var(--mono); font-size: 9px; padding: 2px 6px;
    border-radius: 3px; border: 1px solid var(--rule); white-space: nowrap;
    color: var(--ink-soft);
  }
  .pm-chip b { color: var(--ink) }
  /* Chip ring/figure match the badge ramp: none < partial < full. */
  .pm-chip.gap { border-color: var(--rate-weak) }
  .pm-chip.gap b { color: var(--rate-weak) }
  .pm-chip.part { border-color: var(--rate-mixed) }
  .pm-chip.part b { color: var(--rate-mixed) }
  .pm-chip.ok { border-color: var(--rate-good) }
  .pm-chip.ok b { color: var(--rate-good) }
  /* Row verdict, as a left edge so it survives greyscale. */
  tr.pm-v-gap td:first-child { box-shadow: inset 3px 0 0 var(--pm-behind) }
  tr.pm-v-overclaim td:first-child { box-shadow: inset 3px 0 0 var(--rate-unknown) }
  tr.pm-v-ahead td:first-child { box-shadow: inset 3px 0 0 var(--pm-ahead) }
  /* Same green as `ahead`, deliberately. The bar answers "is Firefox covered?",
     and parity means all three engines support it -- a good state. Grey here read
     as "no data" on a row showing three yeses. */
  tr.pm-v-parity td:first-child { box-shadow: inset 3px 0 0 var(--pm-ahead) }

  details.pm-none > summary {
    font-family: var(--mono); font-size: 9.5px; color: var(--ink-soft);
    cursor: pointer; padding: 6px 0; list-style: none;
  }
  details.pm-none > summary::before { content: "\25B8 " }
  details.pm-none[open] > summary::before { content: "\25BE " }
  @media (max-width: 820px) {
    .pm-cont-h { grid-template-columns: minmax(0, 1fr); gap: 4px }
    .pm-cont-n2 { text-align: left }
    .pm-badge-cell { justify-self: start }
  }
  /* Support answers as words. Colour carries emphasis, the word carries the
     meaning, so the table needs no glyph legend to be readable. */
  td.pm-w {
    text-align: center; font-family: var(--mono); font-size: 9.5px;
    text-transform: uppercase; letter-spacing: .04em;
  }
  td.pm-w.yes { color: var(--pm-ahead); font-weight: 700 }
  /* Recessive: hardware acceleration qualifies a "yes", it does not compete with
     it. Same reason the grid is lighter than the marks. */
  /* Group heading inside a container table. Quieter than the surface heading
     above it, louder than the rows -- it is a divider, not a section. */
  /* Hover affordance for the build caveat on a browser row. */
  .pm-caveat {
    display: inline-block; width: 12px; height: 12px; line-height: 12px;
    text-align: center; border-radius: 50%; font-size: 8.5px; font-weight: 700;
    background: var(--rule); color: var(--ink-soft); cursor: help;
    vertical-align: 1px;
  }
  .pm-kind {
    margin: 10px 0 2px; font-size: 10px; font-family: var(--mono);
    text-transform: uppercase; letter-spacing: .06em; color: var(--ink-soft);
  }

  td.pm-w.maybe { color: var(--rate-mixed) }
  td.pm-w.no { color: var(--muted) }
  td.pm-w.unk { color: var(--muted); font-style: italic }
  td.pm-cell { text-align: center; font-size: 13px; line-height: 1 }
  td.pm-cell.yes { color: var(--pm-ahead) }
  td.pm-cell.no { color: var(--muted) }

  @media (max-width: 820px) {
    /* Below this the fixed label columns squeeze the track to nothing, so the
       chart silently disappears. Stack instead. */
    .pm-row, .pm-plot-row, .pm-axis { grid-template-columns: minmax(0, 1fr) }
    .pm-verdict, .pm-value { text-align: left }
    .pm-axis-dir { display: none }
  }
  .rm-hidden { display: none !important; }
  #queue-table a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: color 0.15s, border-color 0.15s;
  }
  #queue-table a:hover {
    color: var(--red);
    border-bottom-color: var(--red);
  }
  .table-wrap { overflow-x: auto; }
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: var(--ink); }
  th.sortable.active-sort { color: var(--red); }
  th.sortable.active-sort::after {
    content: " ↓";
    font-weight: 700;
  }
  .footer-note {
    font-family: var(--serif);
    font-style: italic;
    font-variation-settings: "opsz" 12, "wght" 400, "SOFT" 50;
    font-size: 12px;
    color: var(--muted);
    margin-top: 10px;
    line-height: 1.5;
  }

  /* Info chip + tooltip */
  .info {
    display: inline-block;
    margin-left: 6px;
    width: 14px; height: 14px;
    font-size: 10px; line-height: 14px; text-align: center;
    border-radius: 50%;
    background: var(--paper-warm); color: var(--muted);
    cursor: help;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-variation-settings: "opsz" 9, "wght" 600;
    transition: background 0.15s, color 0.15s;
    vertical-align: 1px;
  }
  .info::before { content: "i"; }
  .info:hover { background: var(--red); color: var(--paper); }
  section h2 .info { vertical-align: middle; }

  .tip-floating {
    position: fixed; display: none;
    max-width: 280px;
    background: var(--ink); color: var(--paper);
    padding: 10px 12px; border-radius: 2px;
    font-family: var(--sans);
    font-size: 12px; font-weight: 400; line-height: 1.5;
    box-shadow: 0 8px 24px rgba(0,0,0,.28);
    z-index: 1000;
    pointer-events: none;
    white-space: normal;
  }

  /* View axis: data-view ∈ {team, member, queue, recent} */
  body[data-view="team"]    .member-only, body[data-view="team"]    .queue-only,
  body[data-view="member"]  .team-only,   body[data-view="member"]  .queue-only,
  body[data-view="queue"]   .team-only,   body[data-view="queue"]   .member-only
    { display: none !important; }

  /* Recent Changes is the 4th view. Stated additively so the matrix
     above stays readable: hide everyone else's sections in recent, and
     hide recent-only everywhere else. */
  body[data-view="recent"] .team-only,
  body[data-view="recent"] .member-only,
  body[data-view="recent"] .queue-only,
  body:not([data-view="recent"]) .recent-only
    { display: none !important; }

  /* Media Health is the 5th view, and unlike the other four it only exists
     for the team that has a roadmap — the tab removes itself when no roadmap
     payload was injected. Stated additively for the same reason as above. */
  body[data-view="health"] .team-only,
  body[data-view="health"] .member-only,
  body[data-view="health"] .queue-only,
  body[data-view="health"] .recent-only,
  body:not([data-view="health"]) .health-only
    { display: none !important; }

  /* Media Health's own axis: data-health ∈ {roadmap, metrics}. */
  body[data-health="metrics"] .roadmap-only,
  body[data-health="roadmap"]     .metrics-only
    { display: none !important; }

  /* Period axis: `.total-only` covers the 1m / 3m / 6m (data-period=total)
     aggregate views; `.weekly-only` is just the Per-Week trend page. */
  body[data-view="team"][data-period="1m"]    .weekly-only,
  body[data-view="team"][data-period="3m"]    .weekly-only,
  body[data-view="team"][data-period="total"] .weekly-only,
  body[data-view="team"][data-period="weekly"] .total-only { display: none !important; }

  /* Three secondary toggle groups share the same top-bar component: the
     Period axis (Team View), the Recent-window axis (Recent Changes) and the
     Media Health axis. Only one is visible at a time, gated by data-view. */
  .toggle-group-recent, .toggle-sep-recent,
  .toggle-group-health, .toggle-sep-health { display: none; }

  body[data-view="member"] .toggle-group-period, body[data-view="member"] .toggle-sep,
  body[data-view="queue"]  .toggle-group-period, body[data-view="queue"]  .toggle-sep,
  body[data-view="recent"] .toggle-group-period, body[data-view="recent"] .toggle-sep,
  body[data-view="health"] .toggle-group-period, body[data-view="health"] .toggle-sep
    { display: none; }

  /* Default-off above, shown only in the owning view — so no rule needs to
     name any other view, and a 6th view adds nothing here. */
  body[data-view="health"] .toggle-group-health { display: flex; }
  body[data-view="health"] .toggle-sep-health { display: block; }

  /* Recent Changes shows the week/month group instead (same styling as Period). */
  body[data-view="recent"] .toggle-group-recent { display: flex; }
  body[data-view="recent"] .toggle-sep-recent { display: block; }

  /* Profile select */
  .profile-select {
    font-family: var(--mono);
    font-size: 12px;
    padding: 8px 14px;
    border-radius: 2px;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink);
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .profile-select:hover { border-color: var(--ink); }
  .profile-select:focus-visible {
